":"2026-11-14T21:11:11.515542Z"}},"outputs":[{"name":"stdout","text":"Imports successful.\n","output_type":"stream"}],"execution_count":14},{"cell_type":"markdown","source":"\n# **Cell 3: Load Data & Align**","metadata":{}},{"cell_type":"code","source":"# Load official training data\ntrain_df = pd.read_csv(TRAIN_PATH)\ntest_df = pd.read_csv(TEST_PATH)\n\n# Initialize Atlas\natlas = FeatureAtlas(ATLAS_PATH)\n\n# Align training data to cache order (ensures features match rows)\ntrain_aligned = atlas.align(train_df)\nprint(f\"Aligned train shape: {train_aligned.shape}\")\n\n# Quick check\nprint(f\"Unique prompts: {train_aligned['prompt_id'].nunique()}\")\nprint(f\"Classes: {train_aligned['model'].nunique()}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-14T21:11:11.521876Z","iopub.execute_input":"2026-11-14T21:11:11.52223Z","iopub.status.idle":"2026-11-14T21:11:11.635363Z","shell.execute_reply.started":"2026-11-14T21:11:11.522166Z","shell.execute_reply":"2026-11-14T21:11:11.634726Z"}},"outputs":[{"name":"stdout","text":"Aligned train shape: (2699, 4)\nUnique prompts: 150\nClasses: 18\n","output_type":"stream"}],"execution_count":15},{"cell_type":"markdown","source":"# **Cell 4: Extract Hybrid Features**","metadata":{}},{"cell_type":"code","source":"# 1. Style features (468 dimensions)\nX_style = atlas.features('style')\nprint(f\"Style features shape: {X_style.shape}\")\n\n# 2. Qwen3-8B hidden states from layers 6 and 8\nH_qwen = atlas.features('qwen3_8b_layers', layers=[6, 8])\n# Reshape: [rows, 2 layers × 4096 hidden dim] = [2699, 8192]\nX_qwen = H_qwen.reshape(len(train_aligned), -1)\nprint(f\"Qwen features shape: {X_qwen.shape}\")\n\n# 3. Concatenate style and Qwen\nX_combined = np.concatenate([X_style, X_qwen], axis=1)\nprint(f\"Combined feature shape: {X_combined.shape}\")\n\n# 4. Convert string labels to integer IDs\nfrom sklearn.preprocessing import LabelEncoder\nle = LabelEncoder()\ny = le.fit_transform(train_aligned['model'].to_numpy())\nprint(f\"Encoded labels shape: {y.shape}\")\nprint(f\"Label mapping: {dict(zip(le.classes_, le.transform(le.classes_)))}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-14T21:11:11.636623Z","iopub.execute_input":"2026-11-14T21:11:11.637232Z","iopub.status.idle":"2026-11-14T21:11:11.810394Z","shell.execute_reply.started":"2026-11-14T21:11:11.637172Z","shell.execute_reply":"2026-11-14T21:11:11.809516Z"}},"outputs":[{"name":"stdout","text":"Style features shape: (2699, 468)\nQwen features shape: (2699, 8192)\nCombined feature shape: (2699, 8660)\nEncoded labels shape: (2699,)\nLabel mapping: {'claude-fable-5': np.int64(0), 'claude-opus-4-6': np.int64(1), 'claude-opus-4-8': np.int64(2), 'claude-opus-5': np.int64(3), 'claude-sonnet-5': np.int64(4), 'gemini-3.1-pro-preview': np.int64(5), 'gemini-3.6-flash': np.int64(6), 'gemini-3.7-flash': np.int64(7), 'gemini-3.8-flash': np.int64(8), 'glm-5.3': np.int64(9), 'glm-5.3-flash': np.int64(10), 'gpt-5.5': np.int64(11), 'gpt-5.6-luna': np.int64(12), 'gpt-5.6-sol': np.int64(13), 'gpt-5.6-terra': np.int64(14), 'gpt-6-astra': np.int64(15), 'kimi-k3': np.int64(16), 'qwen3.8-max': np.int64(17)}\n","output_type":"stream"}],"execution_count":16},{"cell_type":"markdown","source":"# **Cell 5: Cross-Validation with Atlas Folds**","metadata":{}},{"cell_type":"code","source":"# Get the fold assignments from Atlas\nfold_assignments = atlas.folds(train_aligned)\nprint(f\"Fold assignments shape: {fold_assignments.shape}\")\nprint(f\"Unique fold IDs: {np.unique(fold_assignments)}\")\n\nunique_folds = np.unique(fold_assignments)\nfold_scores = []\noof_preds = np.zeros(len(y), dtype=int)  # integer array for encoded labels\n\nfor fold_id in unique_folds:\n    print(f\"\\n===== Fold {fold_id + 1} =====\")\n    \n    train_mask = fold_assignments != fold_id\n    val_mask = fold_assignments == fold_id\n    \n    X_train, X_val = X_combined[train_mask], X_combined[val_mask]\n    y_train, y_val = y[train_mask], y[val_mask]